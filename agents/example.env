# Model endpoint: any OpenAI-compatible API (leave OPENAI_BASE_URL empty for OpenAI itself)
OPENAI_API_KEY=sk-***
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# CHAT_MODEL_NAME=gpt-5.2
# EMBEDDING_MODEL_NAME=text-embedding-3-small

# NATS (credentials are optional)
# NATS_URL=nats://localhost:4222
# NATS_USER=
# NATS_PASS=
# NATS_TOKEN=
# NATS_CREDS=

# Database (defaults work out of the box)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=ai
# DB_PASS=ai
# DB_DATABASE=ai

# Auth: the gateway passes the user in this header; disable to fall back to "anonymous"
# SERAPH_AUTH_ENABLED=true
# SERAPH_AUTH_USER_HEADER=X-Seraph-User

# Agent file tools
# SERAPH_AGENT_FILE_READ_BYTES=131072
# SERAPH_AGENT_FILE_MAX_SIZE=262144

# Knowledge ingestion
# KB_INGEST_ENABLED=true
# KB_MAX_FILE_BYTES=20971520
# KB_PULL_BATCH=20
# KB_FETCH_TIMEOUT=10.0
# KB_ACK_WAIT_SECONDS=30
# KB_CONSUMER_NAME=seraph-agents-kb
# KB_INGEST_PARALLELISM=4
# KB_IDLE_BACKOFF_BASE=0.5
# KB_IDLE_BACKOFF_MAX=5.0
